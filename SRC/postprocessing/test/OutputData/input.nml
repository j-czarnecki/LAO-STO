&discretization
    k1_steps = 100
    k2_steps = 100
    n_interactions = 1
    n_cooper_pair_hoppings = 1
    sublattices = 2
    subbands = 1
/

&physical_params
    t = 0.
    t_d = 500.0
    t_i = 40.0
    t_rashba = 0.0
    lambda_soc = 10.0
    delta_trigonal = -10.0
    zeta_tetragonal = 0.0
    orb_affected_tetragonal = 1
    v = 200.0
    v_pdp = 28.0
    v_pds = -65.0
    Interaction_names = "intraband"
    Interaction_energies = -50
    Cooper_pair_hopping_names = "intraband"
    Cooper_pair_hopping_multipliers = 0.1
    u_hub = 0.0
    v_hub = 0.0
    e_fermi = 100.0
    v_layer = 1053.0, 1053.0
    subband_energies = 0.,
    g_factor = 10.0,
    B_magnitude = 0.0,
    B_theta = 90.0,
    B_phi = 0.0
/

&self_consistency
    read_gamma_from_file = .false.
    path_to_gamma_start = ''
    read_charge_from_file = .false.
    path_to_charge_start = ''
    gamma_start = 1.0
    gamma_nnn_start = 0.0
    charge_start = 0.1
    max_sc_iter = 1
    sc_alpha = 0.2
    sc_alpha_adapt = 1.0
    gamma_eps_convergence = 1e-3
    charge_eps_convergence = 1e-3
/

&romberg_integration
    romb_eps_x = 1e-4
    interpolation_deg_x = 3
    max_grid_refinements_x = 10
    romb_eps_y = 1e-4
    interpolation_deg_y = 3
    max_grid_refinements_y = 10
/
