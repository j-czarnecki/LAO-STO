!!
!! Unit tests for symmetry module

MODULE test_symmetry
USE, INTRINSIC :: iso_fortran_env, ONLY: real64, int32
USE funit
USE symmetry
USE types
USE parameters
USE reader
IMPLICIT NONE

CONTAINS

SUBROUTINE setup_test_environment()
    !! Setup test environment by creating dummy data files
  TYPE(sc_input_params_t) :: sc_input
  INTEGER(INT32) :: DIM_POSITIVE_K
  CHARACTER(LEN=200) :: test_path

  test_path = 'OutputData/'

  ! Read input to get dimensions
  CALL GET_INPUT(TRIM(test_path)//'input.nml', sc_input)

  DIM_POSITIVE_K = sc_input % discretization % derived % DIM_POSITIVE_K

  ! Create dummy Gamma_SC_final.dat
  CALL create_dummy_gamma_sc(test_path, &
                             DIM_POSITIVE_K, &
                             sc_input % discretization % SUBBANDS)

  ! Create dummy Charge_dens_final.dat
  CALL create_dummy_charge_dens(test_path, &
                                DIM_POSITIVE_K, &
                                sc_input % discretization % SUBBANDS)

  IF (ALLOCATED(sc_input % physical % subband_params % V_layer)) &
    DEALLOCATE (sc_input % physical % subband_params % V_layer)
  IF (ALLOCATED(sc_input % physical % subband_params % Subband_energies)) &
    DEALLOCATE (sc_input % physical % subband_params % Subband_energies)
END SUBROUTINE setup_test_environment

SUBROUTINE create_dummy_gamma_sc(path, dim_positive_k, subbands)
    !! Create dummy Gamma_SC_final.dat file with diagonal elements = 1.0
    !! Format for BAND_BASIS: band i_band j_band neighbour Re(Gamma) Im(Gamma)
  CHARACTER(LEN=*), INTENT(IN) :: path
  INTEGER(INT32), INTENT(IN) :: dim_positive_k, subbands
  INTEGER(INT32) :: i_band, j_band, band, unit_num
  REAL(REAL64) :: gamma_value

  unit_num = 20
  OPEN (UNIT=unit_num, FILE=TRIM(path)//'Gamma_SC_final.dat', &
        FORM='FORMATTED', ACTION='WRITE', STATUS='REPLACE')

  WRITE (unit_num, '(A)') '#band i_band j_band neighbour Re(Gamma) Im(Gamma)'

  DO i_band = 1, dim_positive_k
    DO j_band = 1, dim_positive_k
      ! Diagonal elements = 1.0, off-diagonal = 0.0
      IF (i_band == j_band .AND. i_band <= dim_positive_k / 2) THEN
        gamma_value = (-1.0d0)**(2 * i_band) !1.0d0
      ELSE
        gamma_value = 0.0d0
      END IF

      ! For BAND_BASIS, write all bands for this (i_band, j_band) pair
      DO band = 1, subbands
        WRITE (unit_num, '(4I5, 2E15.5)') band, i_band, j_band, 0, &
          gamma_value, 0.0d0
      END DO
    END DO
    ! Blank lines after completing all j_band for this i_band
    WRITE (unit_num, '(A)') ' '
    WRITE (unit_num, '(A)') ' '
  END DO

  CLOSE (unit_num)
END SUBROUTINE create_dummy_gamma_sc

SUBROUTINE create_dummy_charge_dens(path, dim_positive_k, subbands)
    !! Create dummy Charge_dens_final.dat file with all values = 1.0
  CHARACTER(LEN=*), INTENT(IN) :: path
  INTEGER(INT32), INTENT(IN) :: dim_positive_k, subbands
  INTEGER(INT32) :: i_band, band, unit_num

  unit_num = 21
  OPEN (UNIT=unit_num, FILE=TRIM(path)//'Charge_dens_final.dat', &
        FORM='FORMATTED', ACTION='WRITE', STATUS='REPLACE')

  WRITE (unit_num, '(A)') '#band i_band Charge'

  DO band = 1, subbands
    DO i_band = 1, dim_positive_k
      WRITE (unit_num, '(2I5, E16.5)') band, i_band, 1.0d0
    END DO
  END DO

  CLOSE (unit_num)
END SUBROUTINE create_dummy_charge_dens

@test
SUBROUTINE test_setup_creates_files()
    !! Test that setup creates the necessary input files
  LOGICAL :: file_exists

  CALL setup_test_environment()

  INQUIRE (FILE='OutputData/Gamma_SC_final.dat', EXIST=file_exists)
  @assertTrue(file_exists, 'Gamma_SC_final.dat should be created')

  INQUIRE (FILE='OutputData/Charge_dens_final.dat', EXIST=file_exists)
  @assertTrue(file_exists, 'Charge_dens_final.dat should be created')
END SUBROUTINE test_setup_creates_files

@test
SUBROUTINE test_transform_gamma_to_real_space()
    !! Test TRANSFORM_GAMMA_TO_REAL_SPACE subroutine
  TYPE(post_transformation_t) :: transformation
  LOGICAL :: file_exists

  ! Setup test environment
  CALL setup_test_environment()

  ! Prepare transformation structure
  ! Note: path should be empty as the function adds OutputData/ internally
  transformation % path = ''
  transformation % Nr_points = 50
  transformation % Nphi_points = 50

  ! Call the function under test
  CALL TRANSFORM_GAMMA_TO_REAL_SPACE(transformation)

  ! Verify output files were created
  INQUIRE (FILE='OutputData/Gamma_real_space_transformed.dat', EXIST=file_exists)
  @assertTrue(file_exists, 'Gamma_real_space_transformed.dat should be created')

  INQUIRE (FILE='OutputData/Delta_real_space_transformed.dat', EXIST=file_exists)
  @assertTrue(file_exists, 'Delta_real_space_transformed.dat should be created')

  INQUIRE (FILE='OutputData/Delta_integrand_k.dat', EXIST=file_exists)
  @assertTrue(file_exists, 'Delta_integrand_k.dat should be created')

END SUBROUTINE test_transform_gamma_to_real_space

@test
SUBROUTINE test_calculate_gamma_k()
    !! Test CALCULATE_GAMMA_K subroutine
  TYPE(post_gamma_k_t) :: gamma
  TYPE(sc_input_params_t) :: sc_input
  LOGICAL :: file_exists
  INTEGER(INT32) :: i_band, j_band, band
  CHARACTER(LEN=200) :: filename

  ! Setup test environment
  CALL setup_test_environment()

  ! Read input to get dimensions
  CALL GET_INPUT('OutputData/input.nml', sc_input)

  ! Prepare gamma_k structure
  gamma % path = ''
  gamma % Nk_points = 200

  ! Call the function under test
  CALL CALCULATE_GAMMA_K(gamma)

  ! Verify output files were created
  DO band = 1, MIN(1, sc_input % discretization % SUBBANDS)
    DO i_band = 1, MIN(2, sc_input % discretization % derived % DIM_POSITIVE_K)
      DO j_band = 1, MIN(2, sc_input % discretization % derived % DIM_POSITIVE_K)
        WRITE (filename, "(3(A, I0))") "OutputData/GammaK_i", i_band, "_j", j_band, "_band", band
        INQUIRE (FILE=TRIM(filename)//".dat", EXIST=file_exists)
        @assertTrue(file_exists, TRIM(filename)//'.dat should be created')
      END DO
    END DO
  END DO

  IF (ALLOCATED(sc_input % physical % subband_params % V_layer)) &
    DEALLOCATE (sc_input % physical % subband_params % V_layer)
  IF (ALLOCATED(sc_input % physical % subband_params % Subband_energies)) &
    DEALLOCATE (sc_input % physical % subband_params % Subband_energies)

END SUBROUTINE test_calculate_gamma_k

END MODULE test_symmetry
