&discretization
    k1_steps = 2
    k2_steps = 2
    n_interactions = 1
    n_cooper_pair_hoppings = 1
    sublattices = 2
    subbands = 1
/

&physical_params
    t = 0.1
    t_d = 100.0
    t_i = 10.0
    t_rashba = 1.0
    lambda_soc = 5.0
    delta_trigonal = -5.0
    zeta_tetragonal = 2.5
    orb_affected_tetragonal = 2
    v = 50.0
    v_pdp = 10.0
    v_pds = -20.0
    Interaction_names = "nearest_intra-orb_opposite-spin"
    Interaction_energies = -150
    Cooper_pair_hopping_names = "interorbital"
    Cooper_pair_hopping_multipliers = 0.1
    u_hub = 15.0
    v_hub = 7.5
    e_fermi = -50.0
    v_layer = 100.0, 200.0
    subband_energies = 25.0
    g_factor = 2.0
    B_magnitude = 1.0
    B_theta = 45.0
    B_phi = 30.0
/

&self_consistency
    read_gamma_from_file = .false.
    path_to_gamma_start = ''
    read_charge_from_file = .false.
    path_to_charge_start = ''
    gamma_start = 0.5
    gamma_nnn_start = 0.5
    charge_start = 0.05
    max_sc_iter = 2
    sc_alpha = 0.1
    sc_alpha_adapt = 0.5
    gamma_eps_convergence = 0.001
    charge_eps_convergence = 0.001
/

&romberg_integration
    romb_eps_x = 1e-2
    interpolation_deg_x = 2
    max_grid_refinements_x = 2
    romb_eps_y = 1e-2
    interpolation_deg_y = 2
    max_grid_refinements_y = 2
/
