&sc_gap_calculation
    enable_sc_gap_calc = .true.
    path_to_run_dir_sc_gap = '/test/path/sc_gap/'
    dE_sc_gap = 0.5
    Nk_points_sc_gap = 15
    Nk_points_sc_gap_refined = 30
/

&chern_number_calculation
    enable_chern_number_calc = .true.
    path_to_run_dir_chern_number = '/test/path/chern/'
    Nk_points_chern_number = 25
/

&dispersion_relation_calculation
    enable_dispersion_relation_calc = .true.
    path_to_run_dir_dispersion_relation = '/test/path/dispersion/'
    include_sc_in_dispersion = .true.
    Nr_points_dispersion = 20
    Nphi_points_dispersion = 18
/

&dos_calculation
    enable_dos_calc = .true.
    path_to_run_dir_dos = '/test/path/dos/'
    E_DOS_min = -15.0
    E_DOS_max = 15.0
    dE0 = 0.2
    zeta_DOS = 0.05
    include_sc_in_dos = .true.
    Nk_points_dos = 12
    Nk_points_dos_refined = 24
/

&gamma_k_calculation
    enable_gamma_k_calc = .true.
    path_to_run_dir_gamma_k = '/test/path/gamma_k/'
    Nk_points_gamma_k = 16
/

&projections_calculation
    enable_projections_calc = .true.
    path_to_run_dir_projections = '/test/path/projections/'
    Nr_points_projections = 14
    Nphi_points_projections = 22
/
