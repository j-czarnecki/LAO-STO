MODULE test_local_integrand
USE funit
USE types
USE reader
USE local_integrand
use, intrinsic :: iso_fortran_env, only: real64, int8, int16, int32, int64
IMPLICIT NONE

!------------------------------------------------------------------------------
!-------------------------------- TYPES ---------------------------------------
!------------------------------------------------------------------------------

!------------------------------------------------------------------------------
!----------------------------- LOCAL VARIAVBLES -------------------------------
!------------------------------------------------------------------------------
REAL(REAL64), PARAMETER :: s = 0.5
TYPE(sc_input_params_t) :: sc_input

CONTAINS
!------------------------------------------------------------------------------
!---------------------------- SETUP/TEARDOWN ----------------------------------
!------------------------------------------------------------------------------
@before
SUBROUTINE setup()
  INTEGER(INT32) :: sublats = 2
  INTEGER(INT32) :: n_subbands = 2
  CALL SET_HAMILTONIAN_PARAMS(sublats, n_subbands, sc_input % discretization)
  sc_input % physical % subband_params % t_D = 1.
  sc_input % physical % subband_params % t_I = 1.
  sc_input % physical % subband_params % t_Rashba = 0.
  sc_input % physical % subband_params % lambda_SOC = 1.
  sc_input % physical % subband_params % delta_trigonal = 1.
  sc_input % physical % subband_params % zeta_tetragonal = 0.
  sc_input % physical % subband_params % orb_affected_tetragonal = 1
  sc_input % physical % subband_params % v = 0.
  sc_input % physical % subband_params % V_pdp = 1.
  sc_input % physical % subband_params % V_pds = 1.
  sc_input % physical % subband_params % U_HUB = 0
  sc_input % physical % subband_params % V_HUB = 0
  sc_input % physical % subband_params % E_Fermi = 0
  sc_input % physical % subband_params % V_layer = (/1., 1./)
  sc_input % physical % subband_params % Subband_energies = 0.
  sc_input % physical % subband_params % g_factor = 8
  sc_input % physical % subband_params % eta_p = 1.

  sc_input % physical % external % T = 0.
  sc_input % physical % external % B_field(1) = 0.
  sc_input % physical % external % B_field(2) = 0.
  sc_input % physical % external % B_field(3) = 0.
END SUBROUTINE setup
!------------------------------------------------------------------------------
!------------------------------- HELPERS --------------------------------------
!------------------------------------------------------------------------------

!---------------------------------------------------------------------
!----------------------------- TESTS ---------------------------------
!---------------------------------------------------------------------

@test
SUBROUTINE test_accumulate_charge_density()
  REAL(REAL64) :: Charge(sc_input % discretization % derived % DIM_POSITIVE_K)
  COMPLEX(REAL64) :: U(sc_input % discretization % derived % DIM, sc_input % discretization % derived % DIM) !! Unitary matrix that diagonalizes the Hamiltonian - from ZGEEV
  REAL(REAL64) :: Energies(sc_input % discretization % derived % DIM) !! Energies for given wavevector
  REAL(REAL64) :: T !! Temperature

  REAL(REAL64) :: single_energy
  REAL(REAL64) :: expected_charge
  INTEGER(INT32) :: i

  !TODO: make this test parametrizable

  U = 0.
  !This way we make hole band irrelevant
  DO i = 1, sc_input % discretization % derived % DIM
    U(i, i) = 1.
  END DO

  !Test in zero temperature first
  single_energy = -1
  Charge = 0.
  Energies = 0.
  Energies(:sc_input % discretization % derived % DIM_POSITIVE_K) = single_energy ! So that electron bands are fully occupied
  T = 0.

  CALL ACCUMULATE_CHARGE_DENSITY(Charge, U, Energies, sc_input % discretization, T)

  expected_charge = 1.
  DO i = 1, sc_input % discretization % derived % DIM_POSITIVE_K
    @assertEqual(expected_charge, Charge(i), tolerance=1.0e-7)
  END DO

  !Test in finite temperature
  single_energy = 0.
  Charge = 0.
  Energies = 0.
  Energies(:sc_input % discretization % derived % DIM_POSITIVE_K) = single_energy ! So that electron bands are half-occupied
  T = 100. !Add significant smearing

  CALL ACCUMULATE_CHARGE_DENSITY(Charge, U, Energies, sc_input % discretization, T)

  expected_charge = 0.5
  DO i = 1, sc_input % discretization % derived % DIM_POSITIVE_K
    @assertEqual(expected_charge, Charge(i), tolerance=1.0e-7)
  END DO

  !Make the hole bands relevant
  U = 0.
  DO i = 1, sc_input % discretization % derived % DIM
    U(i, i) = 1.
    IF (i <= sc_input % discretization % derived % DIM_POSITIVE_K) THEN
      U(i, i + sc_input % discretization % derived % DIM_POSITIVE_K) = 0.1
    END IF
  END DO

  single_energy = -1e-3
  Charge = 0.
  Energies(:sc_input % discretization % derived % DIM_POSITIVE_K) = single_energy ! So that electron bands are partially occupied
  Energies(sc_input % discretization % derived % DIM_POSITIVE_K + 1:) = -single_energy ! So that hole bands are partially occupied
  T = 100. !Add significant smearing

  CALL ACCUMULATE_CHARGE_DENSITY(Charge, U, Energies, sc_input % discretization, T)

  expected_charge = fd_distribution(single_energy, 0d0, T) + (0.1)**2 * (1.-fd_distribution(single_energy, 0d0, T))
  DO i = 1, sc_input % discretization % derived % DIM_POSITIVE_K
    @assertEqual(expected_charge, Charge(i), tolerance=1.0e-7)
  END DO

END SUBROUTINE test_accumulate_charge_density

@test
SUBROUTINE test_accumulate_delta_real_space()
  IMPLICIT NONE
  REAL(REAL64) :: J_tensor(sc_input % discretization % derived % DIM_POSITIVE_K,&
                         & sc_input % discretization % derived % DIM_POSITIVE_K, &
                         & sc_input % discretization % derived % DIM_POSITIVE_K, &
                         & sc_input % discretization % derived % DIM_POSITIVE_K) !! Interaction tensor
  REAL(REAL64) :: J_tensor_matrix(sc_input % discretization % derived % DIM_POSITIVE_K**2, &
                                & sc_input % discretization % derived % DIM_POSITIVE_K**2) !! Interaction tensor
  COMPLEX(REAL64) :: Delta(N_ALL_NEIGHBOURS + N_NEIGHBOURS, &
                         & sc_input % discretization % derived % DIM_POSITIVE_K, &
                         & sc_input % discretization % derived % DIM_POSITIVE_K) !! Accumulator for integrand
  COMPLEX(REAL64) :: U(sc_input % discretization % derived % DIM, sc_input % discretization % derived % DIM) !! Unitary matrix that diagonalizes the Hamiltonian - from ZGEEV
  REAL(REAL64) :: Energies(sc_input % discretization % derived % DIM) !! Energies for given wavevector
  REAL(REAL64) :: T !! Temperature
  REAL(REAL64) :: kx, ky !! Wavevector coordinates

  INTEGER(INT32) :: i, j
  INTEGER(INT32) :: spin1, spin2, orb, lat, neigh

  Delta = 0.
  ! This will make only electron bands occupied
  Energies(:sc_input % discretization % derived % DIM_POSITIVE_K) = -1.
  Energies(sc_input % discretization % derived % DIM_POSITIVE_K + 1:) = 1.
  T = 0.
  kx = 0.
  ky = 0.

  J_tensor = 0.
  !Intraband coupling in the spin-orbital-sublattice basis
  DO i = 1, sc_input % discretization % derived % DIM_POSITIVE_K
    J_tensor(i, i, i, i) = 1.
  END DO

  !! Prepare for function
  CALL MATRICIZE_INTERACTION_TENSOR(J_tensor, sc_input % discretization % derived % DIM_POSITIVE_K, J_tensor_matrix)

  ASSOCIATE (J_tensor => sc_input % physical % subband_params % J_tensor)

    J_tensor % n_nonzero = &
      & calculate_number_of_nonzero_elements(J_tensor_matrix)
    @assertEqual(sc_input % discretization % derived % DIM_POSITIVE_K, J_tensor % n_nonzero, message='Unexpected number of nonzero elements')

    ALLOCATE (J_tensor % Values(J_tensor % n_nonzero))
    ALLOCATE (J_tensor % Column_indices(J_tensor % n_nonzero))
    ALLOCATE (J_tensor % Row_indices(sc_input % discretization % derived % DIM_POSITIVE_K**2 + 1))

    CALL SAVE_SPARSE_MATRIX_IN_CRS(J_tensor_matrix, J_tensor % Values, &
      & J_tensor % Column_indices, &
      & J_tensor % Row_indices, &
      & J_tensor % n_nonzero, sc_input % discretization % derived % DIM_POSITIVE_K**2)

    !TODO: Change it to parametrized TC
    ! ----- SCENARIO 1 -----
    !This way we make hole band irrelevant
    U = 0.
    DO i = 1, sc_input % discretization % derived % DIM
      U(i, i) = 1.
    END DO

    CALL ACCUMULATE_DELTA_REAL_SPACE(Delta, J_tensor % Values, &
      & J_tensor % Column_indices, &
      & J_tensor % Row_indices, &
      & U, Energies, kx, ky, sc_input % discretization, &
      & J_tensor % n_nonzero, T)

    !Since I have no electron-hole mixing in unitary matrix U, I will have no superconducting coupling at all
    DO neigh = 1, N_ALL_NEIGHBOURS + N_NEIGHBOURS
      DO i = 1, sc_input % discretization % derived % DIM_POSITIVE_K
        DO j = 1, sc_input % discretization % derived % DIM_POSITIVE_K
          @assertEqual(0., Delta(neigh, i, j), tolerance=1.0e-7)
        END DO
      END DO
    END DO

    !! TODO: Currently this is not physical, because intralayer coupling should not induce interlayer anomalous averages.
    !! TODO: Think about betterr testing for this case.
    ! ----- SCENARIO 2 -----
    !Now set mixing between electron and hole bands for the same set of quantum numbers
    U = 0.
    DO i = 1, sc_input % discretization % derived % DIM
      U(i, i) = 1.
      IF (i <= sc_input % discretization % derived % DIM_POSITIVE_K) THEN
        U(i, i + sc_input % discretization % derived % DIM_POSITIVE_K) = 0.1
      END IF
    END DO
    CALL COMPUTE_CONJUGATE_ELEMENTS(U, sc_input % discretization % derived % DIM)

    Delta = 0.
    CALL ACCUMULATE_DELTA_REAL_SPACE(Delta, J_tensor % Values, &
      & J_tensor % Column_indices, &
      & J_tensor % Row_indices, &
      & U, Energies, kx, ky, sc_input % discretization, &
      & J_tensor % n_nonzero, T)

    !But for the interlayer coupling, it should give zero
    DO neigh = 1, N_ALL_NEIGHBOURS + N_NEIGHBOURS
      DO i = 1, sc_input % discretization % derived % DIM_POSITIVE_K
        DO j = 1, sc_input % discretization % derived % DIM_POSITIVE_K
          ! Because we only compute for nearest neighbours
          !! All off-diagonal terms should be zero
          IF (i /= j) THEN
            @assertEqual(0., Delta(neigh, i, j), tolerance=1.0e-7)
          ELSE
            @assertEqual(0.1, Delta(neigh, i, j), tolerance=1.0e-7)
          END IF
        END DO
      END DO
    END DO
  END ASSOCIATE

END SUBROUTINE test_accumulate_delta_real_space

! @test
! SUBROUTINE test_accumulate_delta_real_space_k_symmetry()
!   IMPLICIT NONE
!   COMPLEX(REAL64) :: Hamiltonian_const(sc_input % discretization % derived % DIM, sc_input % discretization % derived % DIM)
