MODULE test_local_integrand
USE funit
USE types
USE local_integrand
use, intrinsic :: iso_fortran_env, only: real64, int8, int16, int32, int64
IMPLICIT NONE

!------------------------------------------------------------------------------
!-------------------------------- TYPES ---------------------------------------
!------------------------------------------------------------------------------

!------------------------------------------------------------------------------
!----------------------------- LOCAL VARIAVBLES -------------------------------
!------------------------------------------------------------------------------
REAL(REAL64), PARAMETER :: s = 0.5
TYPE(sc_input_params_t) :: sc_input

CONTAINS
!------------------------------------------------------------------------------
!---------------------------- SETUP/TEARDOWN ----------------------------------
!------------------------------------------------------------------------------
@before
SUBROUTINE setup()
  INTEGER(INT32) :: sublats = 2
  INTEGER(INT32) :: n_subbands = 2
  CALL SET_HAMILTONIAN_PARAMS(sublats, n_subbands, sc_input % discretization)
  sc_input % physical % subband_params % t_D = 1.
  sc_input % physical % subband_params % t_I = 1.
  sc_input % physical % subband_params % t_Rashba = 0.
  sc_input % physical % subband_params % lambda_SOC = 1.
  sc_input % physical % subband_params % delta_trigonal = 1.
  sc_input % physical % subband_params % zeta_tetragonal = 0.
  sc_input % physical % subband_params % orb_affected_tetragonal = 1
  sc_input % physical % subband_params % v = 0.
  sc_input % physical % subband_params % V_pdp = 1.
  sc_input % physical % subband_params % V_pds = 1.
  sc_input % physical % subband_params % J_SC_tensor = 0
  sc_input % physical % subband_params % nearest_interorb_multiplier = 0
  sc_input % physical % subband_params % J_SC_NNN_tensor = 0
  sc_input % physical % subband_params % next_interorb_multiplier = 0
  sc_input % physical % subband_params % U_HUB = 0
  sc_input % physical % subband_params % V_HUB = 0
  sc_input % physical % subband_params % E_Fermi = 0
  sc_input % physical % subband_params % V_layer = (/1., 1./)
  sc_input % physical % subband_params % Subband_energies = 0.
  sc_input % physical % subband_params % g_factor = 8
  sc_input % physical % subband_params % eta_p = 1.

  sc_input % physical % external % T = 0.
  sc_input % physical % external % B_field(1) = 0.
  sc_input % physical % external % B_field(2) = 0.
  sc_input % physical % external % B_field(3) = 0.
END SUBROUTINE setup
!------------------------------------------------------------------------------
!------------------------------- HELPERS --------------------------------------
!------------------------------------------------------------------------------

!---------------------------------------------------------------------
!----------------------------- TESTS ---------------------------------
!---------------------------------------------------------------------

@test
SUBROUTINE test_accumulate_charge_density()
  REAL(REAL64) :: Charge(sc_input % discretization % derived % DIM_POSITIVE_K)
  COMPLEX(REAL64) :: U(sc_input % discretization % derived % DIM, sc_input % discretization % derived % DIM) !! Unitary matrix that diagonalizes the Hamiltonian - from ZGEEV
  REAL(REAL64) :: Energies(sc_input % discretization % derived % DIM) !! Energies for given wavevector
  REAL(REAL64) :: T !! Temperature

  REAL(REAL64) :: single_energy
  REAL(REAL64) :: expected_charge
  INTEGER(INT32) :: i

  !TODO: make this test parametrizable

  U = 0.
  !This way we make hole band irrelevant
  DO i = 1, sc_input % discretization % derived % DIM
    U(i, i) = 1.
  END DO

  !Test in zero temperature first
  single_energy = -1
  Charge = 0.
  Energies = 0.
  Energies(:sc_input % discretization % derived % DIM_POSITIVE_K) = single_energy ! So that electron bands are fully occupied
  T = 0.

  CALL ACCUMULATE_CHARGE_DENSITY(Charge, U, Energies, sc_input % discretization, T)

  expected_charge = 1.
  DO i = 1, sc_input % discretization % derived % DIM_POSITIVE_K
    @assertEqual(expected_charge, Charge(i), tolerance=1.0e-7)
  END DO

  !Test in finite temperature
  single_energy = 0.
  Charge = 0.
  Energies = 0.
  Energies(:sc_input % discretization % derived % DIM_POSITIVE_K) = single_energy ! So that electron bands are half-occupied
  T = 100. !Add significant smearing

  CALL ACCUMULATE_CHARGE_DENSITY(Charge, U, Energies, sc_input % discretization, T)

  expected_charge = 0.5
  DO i = 1, sc_input % discretization % derived % DIM_POSITIVE_K
    @assertEqual(expected_charge, Charge(i), tolerance=1.0e-7)
  END DO

  !Make the hole bands relevant
  U = 0.
  DO i = 1, sc_input % discretization % derived % DIM
    U(i, i) = 1.
    IF (i <= sc_input % discretization % derived % DIM_POSITIVE_K) THEN
      U(i, i + sc_input % discretization % derived % DIM_POSITIVE_K) = 0.1
    END IF
  END DO

  single_energy = -1e-3
  Charge = 0.
  Energies(:sc_input % discretization % derived % DIM_POSITIVE_K) = single_energy ! So that electron bands are partially occupied
  Energies(sc_input % discretization % derived % DIM_POSITIVE_K + 1:) = -single_energy ! So that hole bands are partially occupied
  T = 100. !Add significant smearing

  CALL ACCUMULATE_CHARGE_DENSITY(Charge, U, Energies, sc_input % discretization, T)

  expected_charge = fd_distribution(single_energy, 0d0, T) + (0.1)**2 * (1.-fd_distribution(single_energy, 0d0, T))
  DO i = 1, sc_input % discretization % derived % DIM_POSITIVE_K
    @assertEqual(expected_charge, Charge(i), tolerance=1.0e-7)
  END DO

END SUBROUTINE test_accumulate_charge_density

@test
SUBROUTINE test_accumulate_nearest_neighbours_delta()
  IMPLICIT NONE
  COMPLEX(REAL64) :: Delta(sc_input % discretization % ORBITALS,&
                          & N_ALL_NEIGHBOURS, &
                          & SPINS, &
                          & SPINS, &
                          & sc_input % discretization % derived % LAYER_COUPLINGS)
  COMPLEX(REAL64) :: U(sc_input % discretization % derived % DIM, sc_input % discretization % derived % DIM) !! Unitary matrix that diagonalizes the Hamiltonian - from ZGEEV
  REAL(REAL64) :: Energies(sc_input % discretization % derived % DIM) !! Energies for given wavevector
  REAL(REAL64) :: T !! Temperature
  REAL(REAL64) :: J_tensor(SPINS, SPINS, SPINS, SPINS) !! Interaction tensor
  REAL(REAL64) :: kx, ky !! Wavevector coordinates

  INTEGER(INT32) :: i, j
  INTEGER(INT32) :: spin1, spin2, orb, lat, neigh

  Delta = 0.
  Energies = -1.
  T = 0.
  kx = 0.
  ky = 0.

  J_tensor = 0.
  !Singlet coupling only
  J_tensor(1, 2, 2, 1) = 1.
  J_tensor(2, 1, 1, 2) = 1.

  !This way we make hole band irrelevant
  U = 0.
  DO i = 1, sc_input % discretization % derived % DIM
    U(i, i) = 1.
  END DO

  CALL ACCUMULATE_NEAREST_NEIGHBOURS_DELTA(Delta, J_tensor, U, Energies, kx, ky, sc_input % discretization, T)

  !Since I have no electron-hole mixing in unitary matrix U, I will have no superconducting coupling at all
  DO orb = 1, sc_input % discretization % ORBITALS
    DO spin1 = 1, SPINS
      DO spin2 = 1, SPINS
        DO neigh = 1, N_ALL_NEIGHBOURS
          DO lat = 1, sc_input % discretization % derived % LAYER_COUPLINGS
            @assertEqual(0., Delta(orb, neigh, spin1, spin2, lat), tolerance=1.0e-7)
          END DO
        END DO
      END DO
    END DO
  END DO

  !Now set mixing between electron and hole bands in the same lattice
  U = 0.
  !This way we make hole band irrelevant
  DO i = 1, sc_input % discretization % derived % DIM
    U(i, i) = 1.
    IF (i <= sc_input % discretization % derived % DIM_POSITIVE_K) THEN
      U(i, i + sc_input % discretization % derived % DIM_POSITIVE_K) = 0.1
    END IF
  END DO
  CALL COMPUTE_CONJUGATE_ELEMENTS(U, sc_input % discretization % derived % DIM)

  Delta = 0.
  CALL ACCUMULATE_NEAREST_NEIGHBOURS_DELTA(Delta, J_tensor, U, Energies, kx, ky, sc_input % discretization, T)

  !But for the interlayer coupling, it should give zero
  DO orb = 1, sc_input % discretization % ORBITALS
    DO spin1 = 1, SPINS
      DO spin2 = 1, SPINS
        DO neigh = 1, N_ALL_NEIGHBOURS
          DO lat = 1, sc_input % discretization % derived % LAYER_COUPLINGS
            @assertEqual(0., Delta(orb, neigh, spin1, spin2, lat), tolerance=1.0e-7)
          END DO
        END DO
      END DO
    END DO
  END DO

END SUBROUTINE test_accumulate_nearest_neighbours_delta

@test
SUBROUTINE test_accumulate_nearest_neighbours_delta_k_symmetry()
  IMPLICIT NONE
  COMPLEX(REAL64) :: Hamiltonian_const(sc_input % discretization % derived % DIM, sc_input % discretization % derived % DIM)
  COMPLEX(REAL64) :: Hamiltonian(sc_input % discretization % derived % DIM, sc_input % discretization % derived % DIM)
  COMPLEX(REAL64) :: Hamiltonian_rotated(sc_input % discretization % derived % DIM, sc_input % discretization % derived % DIM)
  COMPLEX(REAL64) :: Hamiltonian_minus_k(sc_input % discretization % derived % DIM, sc_input % discretization % derived % DIM)
  COMPLEX(REAL64) :: Gamma_SC(sc_input % discretization % ORBITALS, N_ALL_NEIGHBOURS, SPINS, SPINS, sc_input % discretization % derived % LAYER_COUPLINGS) !! Superconducting energies
  REAL(REAL64) :: Charge(sc_input % discretization % derived % DIM)
  REAL(REAL64) :: Charge_local(sc_input % discretization % derived % DIM)
  COMPLEX(REAL64) :: Delta(sc_input % discretization % ORBITALS,&
                          & N_ALL_NEIGHBOURS, &
                          & SPINS, &
                          & SPINS, &
                          & sc_input % discretization % derived % LAYER_COUPLINGS)
  COMPLEX(REAL64) :: Delta_minus_k(sc_input % discretization % ORBITALS,&
                                  & N_ALL_NEIGHBOURS, &
                                  & SPINS, &
                                  & SPINS, &
                                  & sc_input % discretization % derived % LAYER_COUPLINGS)

  INTEGER(INT32), PARAMETER :: nr_points = 1
  INTEGER(INT32), PARAMETER :: nphi_points = 1

  INTEGER(INT32) :: opposite_spin
  REAL(REAL64) :: r_k, phi_k, phi_k_minus !! Wavevector coordinates
  REAL(REAL64) :: dr, dphi

  INTEGER(INT32) :: ir, jphi
  INTEGER(INT32) :: i, j, n
  INTEGER(INT32) :: spin1, spin2, orb, lat, neigh

  dr = 1./nr_points
  dphi = PI / 2./nphi_points

  !Symmetry of superconducting state
  !Singlet coupling only
  Charge = 0.
  Gamma_SC = 0.
  !Setting fully-symmetric pairing symmetry
  Gamma_SC(:, :N_NEIGHBOURS, 1, 2, :) = CMPLX(1, 0., KIND=REAL64)
  Gamma_SC(:, :N_NEIGHBOURS, 2, 1, :) = CMPLX(-1, 0., KIND=REAL64)
  !coupling for next nearest neighbours
  !Gamma_SC(:, (N_NEIGHBOURS + 1):, 1, 2, :) = CMPLX(gamma_next, 0., KIND=REAL64)
  !Gamma_SC(:, (N_NEIGHBOURS + 1):, 2, 1, :) = CMPLX(-gamma_next, 0., KIND=REAL64)

  !Initial
  sc_input % physical % subband_params % J_SC_tensor(1, 2, 2, 1) = 1.
  sc_input % physical % subband_params % J_SC_tensor(2, 1, 1, 2) = 1.
  !Imposed by symmetry
  sc_input % physical % subband_params % J_SC_tensor(1, 2, 1, 2) = -1.
  sc_input % physical % subband_params % J_SC_tensor(2, 1, 2, 1) = -1.

  Hamiltonian_const = 0.
  CALL COMPUTE_K_INDEPENDENT_TERMS(Hamiltonian_const, sc_input % discretization, sc_input % physical)
  CALL COMPUTE_CONJUGATE_ELEMENTS(Hamiltonian_const, sc_input % discretization % derived % DIM)
  !Main test loop
  DO ir = 0, nr_points
    DO jphi = -nphi_points, nphi_points
      r_k = ir * dr
      phi_k = jphi * dphi
      phi_k_minus = phi_k + PI

      Delta = 0.
      Delta_minus_k = 0.
      Charge_local = 0.
      CALL GET_LOCAL_CHARGE_AND_DELTA(Hamiltonian_const, Gamma_SC, Charge, r_k, phi_k, Delta, Charge_local, sc_input % discretization, sc_input % physical)
      CALL GET_LOCAL_CHARGE_AND_DELTA(Hamiltonian_const, Gamma_SC, Charge, r_k, phi_k_minus, Delta_minus_k, Charge_local, sc_input % discretization, sc_input % physical)

      !But for the interlayer coupling, it should give zero
      DO orb = 1, sc_input % discretization % ORBITALS
        DO spin1 = 1, SPINS
          DO spin2 = 1, SPINS
            DO neigh = 1, N_ALL_NEIGHBOURS
              DO lat = 1, sc_input % discretization % derived % LAYER_COUPLINGS
                ! Conjugation due to k --> -k leading to minus sign in complex exponential
                IF (neigh .le. N_NEIGHBOURS) THEN
                  @assertEqual(Delta(orb, neigh, spin1, spin2, lat), -CONJG(Delta_minus_k(orb, neigh, spin2, spin1, lat)), tolerance=1.0e-7, message='Singlet symmetry broken')
                ELSE
                  @assertEqual(0, Delta(orb, neigh, spin1, spin2, lat), tolerance=1.0e-7, message='Unexpected finite element')
                END IF
              END DO
            END DO
          END DO
        END DO
      END DO
    END DO
  END DO

  !Triplet symmetry only
  Charge = 0.
  Gamma_SC = 0.
  !Setting fully-symmetric pairing symmetry
  Gamma_SC(:, :N_NEIGHBOURS, 1, 1, :) = CMPLX(1, 0., KIND=REAL64)
  Gamma_SC(:, :N_NEIGHBOURS, 2, 2, :) = CMPLX(1, 0., KIND=REAL64)

  !Initial
  sc_input % physical % subband_params % J_SC_tensor = 0.
  sc_input % physical % subband_params % J_SC_tensor(1, 1, 1, 1) = 1.
  sc_input % physical % subband_params % J_SC_tensor(2, 2, 2, 2) = 1.

  Hamiltonian_const = 0.
  CALL COMPUTE_K_INDEPENDENT_TERMS(Hamiltonian_const, sc_input % discretization, sc_input % physical)
  CALL COMPUTE_CONJUGATE_ELEMENTS(Hamiltonian_const, sc_input % discretization % derived % DIM)
  !Main test loop
  DO ir = 1, nr_points
    DO jphi = -nphi_points, nphi_points
      r_k = ir * dr
      phi_k = jphi * dphi
      phi_k_minus = phi_k + PI

      Delta = 0.
      Delta_minus_k = 0.
      Charge_local = 0.
      CALL GET_LOCAL_CHARGE_AND_DELTA(Hamiltonian_const, Gamma_SC, Charge, r_k, phi_k, Delta, Charge_local, sc_input % discretization, sc_input % physical)
      CALL GET_LOCAL_CHARGE_AND_DELTA(Hamiltonian_const, Gamma_SC, Charge, r_k, phi_k_minus, Delta_minus_k, Charge_local, sc_input % discretization, sc_input % physical)

      !But for the interlayer coupling, it should give zero
      DO orb = 1, sc_input % discretization % ORBITALS
        DO spin1 = 1, SPINS
          DO spin2 = 1, SPINS
            DO neigh = 1, N_ALL_NEIGHBOURS
              DO lat = 1, sc_input % discretization % derived % LAYER_COUPLINGS
                ! Conjugation due to k --> -k leading to minus sign in complex exponential
                IF (spin1 .eq. spin2) THEN
                  opposite_spin = MOD(spin1, SPINS) + 1
                  IF (neigh .le. N_NEIGHBOURS) THEN
                    !TODO: Validate that this is a meaningful check
                    @assertEqual(Delta(orb, neigh, spin1, spin2, lat), CONJG(Delta_minus_k(orb, neigh, opposite_spin, opposite_spin, lat)), tolerance=1e-7, message='Triplet symmetry broken')
                  ELSE
                    @assertEqual(0., Delta(orb, neigh, spin1, spin2, lat), tolerance=1e-7, message='Unexpected finite element')
                  END IF
                ELSE
                  @assertEqual(0., Delta(orb, neigh, spin1, spin2, lat), tolerance=1e-7, message='Unexpected finite element')
                END IF
              END DO
            END DO
          END DO
        END DO
      END DO
    END DO
  END DO
END SUBROUTINE

@test
SUBROUTINE test_accumulate_next_neighbours_delta_k_symmetry()
  IMPLICIT NONE
  COMPLEX(REAL64) :: Hamiltonian_const(sc_input % discretization % derived % DIM, sc_input % discretization % derived % DIM)
  COMPLEX(REAL64) :: Hamiltonian(sc_input % discretization % derived % DIM, sc_input % discretization % derived % DIM)
  COMPLEX(REAL64) :: Hamiltonian_rotated(sc_input % discretization % derived % DIM, sc_input % discretization % derived % DIM)
  COMPLEX(REAL64) :: Hamiltonian_minus_k(sc_input % discretization % derived % DIM, sc_input % discretization % derived % DIM)
  COMPLEX(REAL64) :: Gamma_SC(sc_input % discretization % ORBITALS, N_ALL_NEIGHBOURS, SPINS, SPINS, sc_input % discretization % derived % LAYER_COUPLINGS) !! Superconducting energies
  REAL(REAL64) :: Charge(sc_input % discretization % derived % DIM)
  REAL(REAL64) :: Charge_local(sc_input % discretization % derived % DIM)
  COMPLEX(REAL64) :: Delta(sc_input % discretization % ORBITALS,&
                          & N_ALL_NEIGHBOURS, &
                          & SPINS, &
                          & SPINS, &
                          & sc_input % discretization % derived % LAYER_COUPLINGS)
  COMPLEX(REAL64) :: Delta_minus_k(sc_input % discretization % ORBITALS,&
                                  & N_ALL_NEIGHBOURS, &
                                  & SPINS, &
                                  & SPINS, &
                                  & sc_input % discretization % derived % LAYER_COUPLINGS)

  INTEGER(INT32), PARAMETER :: nr_points = 1
  INTEGER(INT32), PARAMETER :: nphi_points = 1

  INTEGER(INT32) :: opposite_spin
  REAL(REAL64) :: r_k, phi_k, phi_k_minus !! Wavevector coordinates
  REAL(REAL64) :: dr, dphi

  INTEGER(INT32) :: ir, jphi
  INTEGER(INT32) :: i, j, n
  INTEGER(INT32) :: spin1, spin2, orb, lat, neigh

  dr = 1./nr_points
  dphi = PI / 2./nphi_points

  !Symmetry of superconducting state
  !Singlet coupling only
  Charge = 0.
  Gamma_SC = 0.
  !Setting fully-symmetric pairing symmetry
  !coupling for next nearest neighbours
  Gamma_SC(:, (N_NEIGHBOURS + 1):, 1, 2, :) = CMPLX(1, 0., KIND=REAL64)
  Gamma_SC(:, (N_NEIGHBOURS + 1):, 2, 1, :) = CMPLX(-1, 0., KIND=REAL64)

  !Initial
  sc_input % physical % subband_params % J_SC_NNN_tensor = 0.
  sc_input % physical % subband_params % J_SC_NNN_tensor(1, 2, 2, 1) = 1.
  sc_input % physical % subband_params % J_SC_NNN_tensor(2, 1, 1, 2) = 1.
  !Imposed by symmetry
  sc_input % physical % subband_params % J_SC_NNN_tensor(1, 2, 1, 2) = -1.
  sc_input % physical % subband_params % J_SC_NNN_tensor(2, 1, 2, 1) = -1.

  Hamiltonian_const = 0.
  CALL COMPUTE_K_INDEPENDENT_TERMS(Hamiltonian_const, sc_input % discretization, sc_input % physical)
  CALL COMPUTE_CONJUGATE_ELEMENTS(Hamiltonian_const, sc_input % discretization % derived % DIM)
  !Main test loop
  DO ir = 0, nr_points
    DO jphi = -nphi_points, nphi_points
      r_k = ir * dr
      phi_k = jphi * dphi
      phi_k_minus = phi_k + PI

      Delta = 0.
      Delta_minus_k = 0.
      Charge_local = 0.
      CALL GET_LOCAL_CHARGE_AND_DELTA(Hamiltonian_const, Gamma_SC, Charge, r_k, phi_k, Delta, Charge_local, sc_input % discretization, sc_input % physical)
      CALL GET_LOCAL_CHARGE_AND_DELTA(Hamiltonian_const, Gamma_SC, Charge, r_k, phi_k_minus, Delta_minus_k, Charge_local, sc_input % discretization, sc_input % physical)

      !But for the interlayer coupling, it should give zero
      DO orb = 1, sc_input % discretization % ORBITALS
        DO spin1 = 1, SPINS
          DO spin2 = 1, SPINS
            DO neigh = 1, N_ALL_NEIGHBOURS
              DO lat = 1, sc_input % discretization % derived % LAYER_COUPLINGS
                ! Conjugation due to k --> -k leading to minus sign in complex exponential
                IF (neigh .gt. N_NEIGHBOURS) THEN
                  @assertEqual(Delta(orb, neigh, spin1, spin2, lat), -CONJG(Delta_minus_k(orb, neigh, spin2, spin1, lat)), tolerance=1.0e-7, message='Singlet symmetry broken')
                ELSE
                  @assertEqual(0, Delta(orb, neigh, spin1, spin2, lat), tolerance=1.0e-7, message='Unexpected finite element')
                END IF
              END DO
            END DO
          END DO
        END DO
      END DO
    END DO
  END DO

  !Symmetry of superconducting state
  !Singlet coupling only
  Charge = 0.
  Gamma_SC = 0.
  !Setting fully-symmetric pairing symmetry
  !coupling for next nearest neighbours
  Gamma_SC(:, (N_NEIGHBOURS + 1):, 1, 1, :) = CMPLX(1, 0., KIND=REAL64)
  Gamma_SC(:, (N_NEIGHBOURS + 1):, 2, 2, :) = CMPLX(1, 0., KIND=REAL64)

  !Initial
  sc_input % physical % subband_params % J_SC_NNN_tensor = 0.
  sc_input % physical % subband_params % J_SC_NNN_tensor(1, 1, 1, 1) = 1.
  sc_input % physical % subband_params % J_SC_NNN_tensor(2, 2, 2, 2) = 1.

  Hamiltonian_const = 0.
  CALL COMPUTE_K_INDEPENDENT_TERMS(Hamiltonian_const, sc_input % discretization, sc_input % physical)
  CALL COMPUTE_CONJUGATE_ELEMENTS(Hamiltonian_const, sc_input % discretization % derived % DIM)
  !Main test loop
  DO ir = 1, nr_points
    DO jphi = -nphi_points, nphi_points
      r_k = ir * dr
      phi_k = jphi * dphi
      phi_k_minus = phi_k + PI

      Delta = 0.
      Delta_minus_k = 0.
      Charge_local = 0.
      CALL GET_LOCAL_CHARGE_AND_DELTA(Hamiltonian_const, Gamma_SC, Charge, r_k, phi_k, Delta, Charge_local, sc_input % discretization, sc_input % physical)
      CALL GET_LOCAL_CHARGE_AND_DELTA(Hamiltonian_const, Gamma_SC, Charge, r_k, phi_k_minus, Delta_minus_k, Charge_local, sc_input % discretization, sc_input % physical)

      !But for the interlayer coupling, it should give zero
      DO orb = 1, sc_input % discretization % ORBITALS
        DO spin1 = 1, SPINS
          DO spin2 = 1, SPINS
            DO neigh = 1, N_ALL_NEIGHBOURS
              DO lat = 1, sc_input % discretization % derived % LAYER_COUPLINGS
                ! Conjugation due to k --> -k leading to minus sign in complex exponential
                IF (spin1 .eq. spin2) THEN
                  opposite_spin = MOD(spin1, SPINS) + 1
                  IF (neigh .gt. N_NEIGHBOURS) THEN
                    !TODO: Validate that this is a meaningful check
                    @assertEqual(Delta(orb, neigh, spin1, spin2, lat), CONJG(Delta_minus_k(orb, neigh, opposite_spin, opposite_spin, lat)), tolerance=1e-7, message='Triplet symmetry broken')
                  ELSE
                    @assertEqual(0., Delta(orb, neigh, spin1, spin2, lat), tolerance=1e-7, message='Unexpected finite element')
                  END IF
                ELSE
                  @assertEqual(0., Delta(orb, neigh, spin1, spin2, lat), tolerance=1e-7, message='Unexpected finite element')
                END IF
              END DO
            END DO
          END DO
        END DO
      END DO
    END DO
  END DO
END SUBROUTINE

END MODULE test_local_integrand
